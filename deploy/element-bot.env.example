# Environment for the element-bot systemd service.
# install_service.sh copies this to /etc/element-bot.env (root-only, mode 600).
# Format is systemd EnvironmentFile: KEY=value, one per line, no `export`,
# and values cannot span multiple lines.

# Required
MATRIX_PASSWORD=
BOT_OPENAI_API_KEY=

# Optional (defaults shown)
#MATRIX_SERVER=https://matrix.org
#MATRIX_USER=@steely-dan:matrix.org
#MATRIX_ROOM_ALIAS=#Bots_sdc2:matrix.org
#OPENAI_MODEL=gpt-4.1-nano

# Particle device (the gong). If unset, the device call is skipped.
#PARTICLE_DEVICE_ID=
#PARTICLE_ACCESS_TOKEN=
#PARTICLE_FUNCTION_NAME=timerExpired
